
extends ../layout

block content
  .container.py-4
    h1.mb-4 Medewerker registreren

    form(method='post', action='/auth/register', class='row g-3')
      .col-12
        label.form-label(for='username') Gebruikersnaam
        input#username.form-control(type='text', name='username', required, autocomplete='off')

      .col-12
        label.form-label(for='password') Wachtwoord
        input#password.form-control(type='password', name='password', required)

      .col-12
        label.form-label(for='role') Rol
        select#role.form-select(name='role')
          option(value='staff' selected) Medewerker
          option(value='admin') Admin

      .col-12
        label.form-label(for='staff_id') (Optioneel) Koppel aan bestaande staff_id
        input#staff_id.form-control(type='number', name='staff_id', min='1', step='1')

      .col-12
        .d-flex.gap-2
          button.btn.btn-primary(type='submit') Registreer
          // Gebruik één van de twee cancel-varianten:
          a.btn.btn-outline-secondary(href='/users') Cancel
          //- of: button.btn.btn-outline-secondary(type='button', onclick='history.back()') Cancel
