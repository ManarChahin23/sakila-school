extends ../layout

block content
  .container
    // Meldingen
    if deleted
      .alert.alert-warning.alert-dismissible.fade.show.d-flex.justify-content-between.align-items-center(role='alert' data-autohide='true')
        span Gebruiker is gedeactiveerd.
        .d-flex.align-items-center.gap-2
          if deletedId
            form.d-inline(method='post', action=`/users/${deletedId}/restore`)
              button.btn.btn-sm.btn-outline-dark(type='submit') Undo
          button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Close')

    if restored
      .alert.alert-success.alert-dismissible.fade.show(role='alert' data-autohide='true')
        | Gebruiker is hersteld.
        button.btn-close(type='button', data-bs-dismiss='alert', aria-label='Close')

    // Header
    .d-flex.align-items-center.justify-content-between.mb-3
      h1.mb-0 Users
      a.btn.btn-success(href='/users/create') + New

    // Zoekbalk
    form(method='get', action='/users', class='mb-3 d-flex gap-2')
      input.form-control(type='text', name='q', placeholder='Search name or email', value=(q || ''))
      input(type='hidden', name='order', value=order)
      button.btn.btn-secondary(type='submit') Search
      if q
        a.btn.btn-outline-secondary(href='/users') Clear

    // Teller
    //- const startRow = total ? (currentPage - 1) * limit + 1 : 0
    //- const endRow = Math.min(currentPage * limit, total)
    //p.text-muted.mb-2
      | Showing #{startRow}-#{endRow} of #{total} result(s)

    // Tabel
    table.table.table-striped
      thead
        tr
          th ID
          th First name
          th Last name
          th Email
          th Actions
      tbody
        if users && users.length
          each u in users
            tr
              td= u.customer_id
              td= u.first_name
              td= u.last_name
              td= u.email
              td
                a.btn.btn-primary.btn-sm(href=`/users/${u.customer_id}/details`) Details
                form.d-inline.ms-2(method='post', action=`/users/${u.customer_id}/delete`, onsubmit='return confirm("Weet je zeker dat je deze gebruiker wilt verwijderen?")')
                  button.btn.btn-danger.btn-sm(type='submit') Delete
        else
          tr
            td(colspan='5') Geen resultaten gevonden.

    // Paginering
    - const qs = (q ? ('&q=' + encodeURIComponent(q)) : '') + (order ? ('&order=' + encodeURIComponent(order)) : '')
    if totalPages && totalPages > 1
      nav(aria-label='Paginering').mt-3
        ul.pagination.justify-content-center
          // Previous
          if currentPage > 1
            li.page-item
              a.page-link(href=`?page=${currentPage - 1}${qs}`) Previous
          else
            li.page-item.disabled
              span.page-link Previous

          // Page numbers
          each v, idx in Array(totalPages).fill(0)
            - const p = idx + 1
            li.page-item(class=(p === currentPage ? 'active' : ''))
              a.page-link(href=`?page=${p}${qs}`)= p

          // Next
          if currentPage < totalPages
            li.page-item
              a.page-link(href=`?page=${currentPage + 1}${qs}`) Next
          else
            li.page-item.disabled
              span.page-link Next
