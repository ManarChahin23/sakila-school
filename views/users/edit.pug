extends ../layout

block content
  .container
    h1 Edit #{user.first_name}

    form(method='post', action=`/users/${user.customer_id}/edit`)
      .mb-3
        label.form-label(for='first_name') First name
        input.form-control(
          type='text'
          id='first_name'
          name='first_name'
          value=(user.first_name || '')
          class=errors.first_name ? 'is-invalid' : ''
        )
        if errors.first_name
          .invalid-feedback= errors.first_name

      .mb-3
        label.form-label(for='last_name') Last name
        input.form-control(
          type='text'
          id='last_name'
          name='last_name'
          value=(user.last_name || '')
          class=errors.last_name ? 'is-invalid' : ''
        )
        if errors.last_name
          .invalid-feedback= errors.last_name

      .mb-3
        label.form-label(for='email') Email (optional)
        input.form-control(type='email', id='email', name='email', value=(user.email || ''))

      .d-flex.gap-2
        a.btn.btn-outline-secondary(href=`/users/${user.customer_id}/details`) Cancel
        button.btn.btn-primary(type='submit') Save
